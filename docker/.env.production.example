PORT=3000

# MySQL instalado na maquina hospedeira, fora do Docker.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=agrosys_app
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=agrosys

# Origem publica exata, sem barra no final.
FRONTEND_URL=https://agrosys.exemplo.com.br

# Necessario apenas para recuperacao de senha.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_FROM=AgroSys <nao-responda@exemplo.com.br>
