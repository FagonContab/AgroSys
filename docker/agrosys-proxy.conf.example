# Copie este arquivo para o diretorio de configuracoes adicionais do proxy.
# Troque o dominio e os caminhos do certificado antes de habilita-lo.

server {
    listen 80;
    server_name agrosys.exemplo.com.br;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name agrosys.exemplo.com.br;

    ssl_certificate /etc/letsencrypt/live/agrosys.exemplo.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agrosys.exemplo.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://agrosys-web:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
